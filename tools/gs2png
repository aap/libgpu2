#!/usr/bin/env python3
"""gs2png - one command from a PCSX2 GS dump to PNGs of the rendered frame.

    gs2png <dump.gs|dump.gs.zst> [-o outdir] [--vsync] [--spec S ...] [-f]

Unpacks the dump (gsprep.py), replays it through Sony's 1998 GS model
(gsreplay, built on demand), figures out what the dump was displaying from
its privileged-register snapshots (DISPFB/DISPLAY/PMODE/SMODE2), and renders
the displayed framebuffer(s) of every snapshot to PNG.

    -o outdir    working/output directory (default: dump name minus .gs)
    --vsync      snapshot + render at every vsync, not just the end
    --spec S     override buffer detection; S = tbp:bw:w:h[:name[:psm]]
                 (repeatable; psm = 32/24/16/16s)
    -f           force re-unpack and re-replay

Outputs land in outdir:  snapNNN_*_<circ>.png plus shot.png, PCSX2's own
render of the same frame, for reference.
"""
import os, struct, subprocess, sys

TOOLS = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, TOOLS)
import topng

# offsets of the GS privileged registers inside a type-2 stream record
# (the record is an image of the 0x12000000 page, 16 bytes per register)
PMODE, SMODE2, DISPFB1, DISPLAY1, DISPFB2, DISPLAY2 = \
    0x00, 0x20, 0x70, 0x80, 0x90, 0xa0

PSM = {0: '32', 1: '24', 2: '16', 10: '16s'}


def last_privregs(streamfile):
    d = open(streamfile, 'rb').read()
    assert d[:4] == b'GSR1'
    off, end, last = 8, len(d), None
    while off + 8 <= end:
        typ, nqw = d[off], struct.unpack_from('<I', d, off + 4)[0]
        off += 8
        if typ == 2:
            last = d[off:off + nqw * 16]
        off += nqw * 16
    return last


def detect(streamfile):
    """returns topng specs for the enabled display circuits"""
    pr = last_privregs(streamfile)
    if pr is None:
        return None
    r = lambda o: struct.unpack_from('<Q', pr, o)[0]
    pmode, smode2 = r(PMODE), r(SMODE2)
    # INT=1 FFMD=1: half-height buffer, every line read each field.
    # INT=1 FFMD=0: full-height buffer, fields read alternate lines.
    half_height = (smode2 & 1) and (smode2 >> 1 & 1)
    specs = []
    for circ, (fbreg, dpreg) in enumerate(
            [(DISPFB1, DISPLAY1), (DISPFB2, DISPLAY2)]):
        if not pmode >> circ & 1:
            continue
        fb, dp = r(fbreg), r(dpreg)
        fbp, fbw, psm = fb & 0x1ff, fb >> 9 & 0x3f, fb >> 15 & 0x1f
        dbx, dby = fb >> 32 & 0x7ff, fb >> 43 & 0x7ff
        magh, magv = dp >> 23 & 0xf, dp >> 27 & 3
        w = ((dp >> 32 & 0xfff) + 1) // (magh + 1)
        h = ((dp >> 44 & 0x7ff) + 1) // (magv + 1)
        if half_height:
            h //= 2
        if fbw:
            w = min(w, fbw * 64)
        if psm not in PSM:
            print('circuit %d: unsupported PSM %d, skipping' % (circ + 1, psm))
            continue
        if dbx or dby:
            print('circuit %d: DBX/DBY %d/%d ignored' % (circ + 1, dbx, dby))
        specs.append('%d:%d:%d:%d:fb%d:%s'
                     % (fbp * 32, fbw, w, h, circ + 1, PSM[psm]))
    return specs or None


def main():
    dump, outdir, force, vsync, specs = None, None, False, False, []
    a = sys.argv[1:]
    while a:
        x = a.pop(0)
        if x == '-o':
            outdir = a.pop(0)
        elif x == '--vsync':
            vsync = True
        elif x == '--spec':
            specs.append(a.pop(0))
        elif x == '-f':
            force = True
        elif x.startswith('-'):
            sys.exit(__doc__)
        else:
            dump = x
    if dump is None:
        sys.exit(__doc__)

    if outdir is None:
        outdir = os.path.basename(dump)
        for suf in ('.zst', '.gs'):
            if outdir.endswith(suf):
                outdir = outdir[:-len(suf)]

    stream = os.path.join(outdir, 'stream.bin')
    if force or not os.path.exists(stream):
        subprocess.check_call(
            [sys.executable, os.path.join(TOOLS, 'gsprep.py'), dump, outdir])

    replay = os.path.join(TOOLS, 'gsreplay')
    if not os.path.exists(replay):
        subprocess.check_call(['sh', os.path.join(TOOLS, 'build.sh')])

    for old in os.listdir(outdir):
        if old.startswith('snap') and (old.endswith('.bin')
                                       or old.endswith('.png')):
            os.unlink(os.path.join(outdir, old))
    subprocess.check_call([replay, outdir, '-q', '-s',
                           'vsync' if vsync else 'end'])

    if not specs:
        specs = detect(stream)
        if specs is None:
            sys.exit('no privileged-register snapshot in the dump and no '
                     '--spec given;\npass --spec tbp:bw:w:h[:name[:psm]]')
        print('display: %s' % ' '.join(specs))

    for snap in sorted(os.listdir(outdir)):
        if snap.startswith('snap') and snap.endswith('.bin'):
            p = os.path.join(outdir, snap)
            for png in topng.render(p, specs):
                print(png)


if __name__ == '__main__':
    main()
